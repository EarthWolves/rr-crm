# Postgres connection string. Railway sets this for you when you add a Postgres database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rrcrm
# Optional: secret for signing session cookies. If unset, one is generated and stored in the database.
JWT_SECRET=
# Optional: force SSL to the database ("require") or disable it ("disable"). Auto-detected otherwise.
PGSSL=
PORT=3000
